# EvalForge Configuration Template
# NOTE: Do NOT place real secrets or credentials in this file.

# Environment Mode
DEMO_MODE=true
DEMO_ADMIN_KEY=evalforge-demo-secret-key-2026

# Storage Paths
EVALFORGE_DB_PATH=evalforge.db
EVALFORGE_FIXTURES_PATH=fixtures/recorded_responses.json

# Execution & Cost Governance
MAX_RUN_COST_USD=10.0
MAX_CONCURRENCY=4
MAX_RETRIES=3

# Logging & Privacy
LOG_LEVEL=INFO
REDACT_SENSITIVE=true

# Hosted Provider Configuration (Leave empty for offline / fixture runs)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
